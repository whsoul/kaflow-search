{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kaflow Search Demo",
  "version": "0.1.2",
  "identifier": "com.whsoul-tool.kaflow.demo",
  "build": {
    "frontendDist": "../../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Kaflow Search (Demo)",
        "width": 1440,
        "height": 900
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
